# Public allowlist policy
# Default: keep repository contents local unless explicitly allowed below.
/*

# Public root files
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/LICENSE
!/README.md
!/pyproject.toml
!/requirements.txt

# Public application source
!/src/
!/src/**

# Public maintenance scripts and tests
!/scripts/
!/scripts/**
!/tests/
!/tests/**

# Private/local source subtrees
/src/my_app/config/
/src/my_app/models/

# Local editor / AI assistant state
/.claude/
/.codex/
/.cursor/
/.idea/
/.ropeproject/
/.windsurf/
/.aider*

# Local working notes, launchers, user data, and media/output folders
/TASKS.md
/Start_TimbrosaField.command
/data/
/docs/
/.github/
/Ableton/
/FieldRecordings/
/ableton/
/fieldrecordings/
/timbrosafield/
/wav/
/backups/
/backup/
/config/

# Audio, Ableton, backups, binary/local artifacts
*.asd
*.als
*.bak
*.bin
*.jpeg
*.json
*.wav
*.WAV
*.wav.bak
*.WAV.bak
*.command
.DS_Store

# Python caches and compiled files
__pycache__/
*.py[codz]
*$py.class
*.so

# Build, packaging, and installer outputs
.Python
/build/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# Test, lint, type-check, and coverage outputs
/.cache/
/.coverage
/.coverage.*
/.hypothesis/
/.mypy_cache/
/.nox/
/.pytest_cache/
/.ruff_cache/
/.tox/
/.pyre/
/.pytype/
/cover/
/htmlcov/
coverage.xml
*.cover
*.py.cover
nosetests.xml

# Virtual environments and Python environment managers
/.env
/.envrc
/.venv
/env/
/venv/
/ENV/
/env.bak/
/venv.bak/
/.pdm-python
/.pdm-build/
/.pixi/
/__pypackages__/

# Tool-specific local state
/.abstra/
/.ipynb_checkpoints/
/.scrapy/
/.spyderproject
/.spyproject
/.pypirc
/.cursorignore
/.cursorindexingignore
/__marimo__/
/marimo/_static/
/marimo/_lsp/

# Runtime/database/log artifacts
*.log
db.sqlite3
db.sqlite3-journal
local_settings.py
celerybeat-schedule
celerybeat.pid
*.sage.py

# External/public datasets should not be committed
/data/
